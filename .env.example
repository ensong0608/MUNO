# MUNO Local Development Configuration
# Copy this file to .env and modify as needed.
# .env is gitignored and will not be committed.

# Environment: Prod | Dev | UAT
MUNO_ENV=Dev

# Personal/local backend API URL for this environment.
# MUNO does not use Mixar's hosted backend.
MUNO_BACKEND_URL=http://127.0.0.1:8765

# Personal/local frontend URL for auth or account UI if we add one later.
MUNO_FRONTEND_URL=http://127.0.0.1:3000

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
MUNO_LOG_LEVEL=DEBUG